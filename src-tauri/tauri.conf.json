{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptionFab",
  "version": "3.6.0",
  "identifier": "com.captionfab.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CaptionFab — 视频字幕提取工具",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; connect-src 'self' ipc: tauri:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'self' blob:; media-src 'self' asset: blob: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "CaptionFab - 视频字幕提取工具",
    "longDescription": "CaptionFab 是一款基于 OCR 的视频字幕提取工具。它使用 Tesseract.js、PaddleOCR 或 EasyOCR 从视频中提取硬编码字幕，并支持导出为 SRT、VTT、ASS、SSA、JSON、TXT、LRC、SBV 和 CSV 等多种格式。",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "asset-protocol": {
      "all": false,
      "assetScope": ["$resource/**", "$app/**", "$temp/**"]
    }
  }
}
