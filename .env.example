# CaptionFab 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ── 开发服务器 ──────────────────────────────────────────
# VITE_APP_TITLE=CaptionFab
# VITE_APP_VERSION=3.6.0

# ── OCR 引擎配置 ─────────────────────────────────────────
# 可选: 切换默认 OCR 引擎 (tesseract | paddle | easyocr)
# VITE_OCR_DEFAULT_ENGINE=tesseract

# ── PaddleOCR (如启用) ───────────────────────────────────
# PaddleOCR 模型路径 (本地部署时使用)
# VITE_PADDLE_MODEL_PATH=./models/paddle

# ── EasyOCR (如启用) ─────────────────────────────────────
# EasyOCR 模型缓存目录
# VITE_EASYOCR_MODEL_DIR=./models/easyocr

# ── Tesseract ────────────────────────────────────────────
# Tesseract 语言数据路径 (系统级配置，通常无需修改)
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

# ── 性能配置 ─────────────────────────────────────────────
# 并发处理线程数 (默认: CPU 核心数)
# VITE_MAX_WORKERS=4

# 批处理最大文件大小 (MB)
# VITE_MAX_FILE_SIZE_MB=500

# ── 日志配置 ─────────────────────────────────────────────
# 日志级别: debug | info | warn | error
# VITE_LOG_LEVEL=info
